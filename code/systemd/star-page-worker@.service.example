[Unit]
Description=星页 StarPage · 生成 Worker %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/star-page/code/backend
EnvironmentFile=/root/star-page/config/db.env
EnvironmentFile=/root/star-page/config/oss.env
EnvironmentFile=/root/star-page/config/llm.env
EnvironmentFile=-/root/star-page/config/aliyun.env
EnvironmentFile=-/root/star-page/config/huoshan.env
Environment=PUBLIC_BASE_URL=https://stars-page.com
Environment=FRONTEND_ORIGIN=https://stars-page.com
# 可以开多个（@1、@2…）：名额按库里 running 的任务数算，各实例的 GENERATION_* 上限要一致。不对外提供 HTTP。
Environment=APP_ROLE=worker
Environment=DB_POOL_SIZE=20
Environment=DB_MAX_OVERFLOW=30
Environment=DOCUMENT_PARSE_THREADS=1
# 生成质量三步改造：截断自动续写、续写局部编辑（SEARCH/REPLACE）、发布前无头渲染检查（off / observe / repair）
Environment=GENERATION_TRUNCATION_CONTINUES=1
Environment=PAGE_EDIT_MODE_ENABLED=true
Environment=PAGE_RENDER_CHECK_MODE=observe
Environment=PAGE_RENDER_CHECK_CONCURRENCY=2
Environment=PAGE_RENDER_CHECK_CHROMIUM_PATH=/root/.cache/ms-playwright/chromium-1248/chrome-linux64/chrome
ExecStart=/root/star-page/code/backend/.venv/bin/python -m app.worker
Restart=always
# 每路模型流式调用、OSS、数据库连接都占一个文件描述符，默认软上限 1024。
LimitNOFILE=65536
# 内存兜底（含解析与渲染检查子进程）：超过 2G 开始回收，到 3G 只杀当前 worker，不连累整机。
MemoryHigh=2G
MemoryMax=3G
RestartSec=3
# 退出时先排空：不领新任务，等手上的跑完（WORKER_DRAIN_TIMEOUT_SECONDS 默认 360 秒），超时的交给别的 worker 接手。
# 停止超时要比排空时限长，否则排空到一半就被强杀（强杀也不丢任务，只是要等 45 秒续期过期才被接手）。
TimeoutStopSec=390s

[Install]
WantedBy=multi-user.target
