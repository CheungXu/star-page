[Unit]
Description=星页 StarPage · 生成 Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/star-page/code/backend
EnvironmentFile=/root/star-page/config/db.env
EnvironmentFile=/root/star-page/config/oss.env
EnvironmentFile=/root/star-page/config/llm.env
EnvironmentFile=-/root/star-page/config/aliyun.env
EnvironmentFile=-/root/star-page/config/huoshan.env
Environment=PUBLIC_BASE_URL=https://stars-page.com
Environment=FRONTEND_ORIGIN=https://stars-page.com
# 只能开一个：生成名额和任务登记表都在这个进程的内存里。不对外提供 HTTP。
Environment=APP_ROLE=worker
Environment=DB_POOL_SIZE=20
Environment=DB_MAX_OVERFLOW=30
ExecStart=/root/star-page/code/backend/.venv/bin/python -m app.worker
Restart=always
# 每路模型流式调用、OSS、数据库连接都占一个文件描述符，默认软上限 1024。
LimitNOFILE=65536
RestartSec=3
# 退出时只取消在跑的生成、不改状态，下次启动扫尾重跑；最多等 3 秒协程收尾。
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
