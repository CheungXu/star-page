# 外部技能原始仓库（仅作改造参考，不纳入版本库）
# 这些目录由克隆上游 skills 仓库产生，体积较大且各自带 .git，
# 改造后的成品在 skills/page-skills/ 下，原始件无需提交。
skills/ori-page-skills/

# 本地与服务器真实环境变量，包含数据库、OSS、LLM、短信等密钥
config/*.env

# Python 虚拟环境
.venv/
code/backend/.venv/

# hyperframes 视频工程的中间产物（逐句配音、检查截帧、渲染日志）
data/视频/**/assets/voice-parts/
data/视频/**/snapshots/
data/视频/**/renders.log
data/视频/**/renders/.hf-segments/

# 小红书登录二维码，短时有效，不入库
data/growth/xhs/login-qr.png

# 小红书登录态，含账号会话，严禁入库
cookies.json

# 发给推广人的图文压缩包，可再打包，不入库
data/文案/202610/发包/*.zip
