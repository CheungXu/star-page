# PostgreSQL/RDS 连接配置模板。
# 复制为 config/db.env 后填写真实值；config/*.env 已被忽略，不要提交真实 db.env。

# 优先使用 RDS 内网地址。如果轻量服务器无法内网访问，再使用公网地址并限制白名单。
PGHOST=
PGPORT=5432
PGDATABASE=stars_page
PGUSER=
PGPASSWORD=

# 也可以改用完整连接串。若填写 DATABASE_URL，测试脚本会优先使用它。
DATABASE_URL=

# 应用连接池。不填则用代码默认：常驻 30，突发再借 40，合计最多 70，等待 30 秒。
# 连接超过 1800 秒会在下次借出前换新，避免用到被数据库端断开的旧连接。
# 预览实例如果和线上连同一个 RDS，把池子调小，例如 DB_POOL_SIZE=5、DB_MAX_OVERFLOW=5。
# DB_POOL_SIZE=30
# DB_MAX_OVERFLOW=40
# DB_POOL_TIMEOUT_SECONDS=30
# DB_POOL_RECYCLE_SECONDS=1800
